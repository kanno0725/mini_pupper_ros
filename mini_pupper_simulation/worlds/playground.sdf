<?xml version="1.0" ?>
<!--
  Gazebo Harmonic 用の空ワールド（IMU + LiDAR 対応版）。
  stock の empty.sdf にセンサ処理用のシステムを足したもの。
  gz-sim のセンサはそれを処理するシステムが world にロードされて初めて動くため、
  Physics/UserCommands/SceneBroadcaster/Contact に加えて次を明示的に読み込む:
    - Imu     : <sensor type="imu"> を処理（物理量のみなので描画不要）
    - Sensors : <sensor type="gpu_lidar"> やカメラなど描画系センサを処理（レンダラを使う）
-->
<sdf version="1.6">
  <world name="playground">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <!-- IMU センサ（<sensor type="imu">）を毎ステップ計算し gz topic に publish する -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <!-- gpu_lidar / camera など描画系センサを毎ステップ描画し gz topic に publish する -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 改善1: 6×6m の部屋を薄い壁で囲う。
         開けた平面だと 2D lidar が大半の方向で何も測れずスキャンマッチが不安定になるため、
         周囲を壁で囲って常にどこかの壁を捉えられるようにする。
         壁は厚さ0.1m・高さ0.6m の静的ボックス。長さ6.2mで四隅を重ねて隙間を無くす。 -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.2 0.1 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6.2 0.1 0.6</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>6.2 0.1 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>6.2 0.1 0.6</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 6.2 0.6</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 6.2 0.6</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.1 6.2 0.6</size></box></geometry>
          <material><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 改善2: 内部の箱を非対称に配置する。
         原点まわりの十字対称だと AMCL が 90/180°回した姿勢と見分けにくく粒子が収束しにくい。
         位置・大きさをバラして各場所のスキャン形状を区別しやすくする。原点(0,0)付近は
         ロボットのスポーン位置なので空けておく。 -->
    <model name="box1">
      <static>true</static>
      <pose>1.2 0.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.5 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box2">
      <static>true</static>
      <pose>-1.5 1.3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 1.0 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.4 1.0 0.5</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box3">
      <static>true</static>
      <pose>0.6 -1.8 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.3 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.8 0.3 0.5</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="box4">
      <static>true</static>
      <pose>-1.8 -1.2 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.6 0.5</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.6 0.6 0.5</size></box></geometry>
          <material><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 改善3: 円柱を混ぜて特徴の変化を増やす（箱と違う曲面でスキャン形状が区別しやすくなる）。 -->
    <model name="cylinder1">
      <static>true</static>
      <pose>1.8 -0.6 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="v">
          <geometry><cylinder><radius>0.2</radius><length>0.5</length></cylinder></geometry>
          <material><diffuse>0.2 0.4 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
